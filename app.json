{
  "expo": {
    "name": "SYNK Talk",
    "slug": "synk-talk",
    "owner": "unmet23s-team",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "synktalk",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lab.synk.talk"
    },
    "android": {
      "package": "lab.synk.talk",
      "adaptiveIcon": {
        "backgroundColor": "#080605",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#080605",
          "imageWidth": 230
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "말하기 연습을 녹음할 때만 마이크를 사용해요. · Зөвхөн ярианы дасгал бичих үед микрофон ашиглана."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "b09a2382-76d1-463a-abf1-957f96f7dedb"
      }
    }
  }
}
