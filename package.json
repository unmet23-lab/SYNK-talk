    "ios": "node tools/앱시작.js start --ios",
    "web": "node tools/앱시작.js start --web",
    "test": "node --test",
    "postinstall": "node tools/BGM빌드.js && node tools/오디오스트림문지기.js",
    "eval": "node tools/eval-score.js evals/출력_v1.json",
