# 이 파일은 **이름만** 담는다. 값은 절대 커밋하지 않는다.
# 실제 값은 .env 에 두고, .env 는 .gitignore 가 막는다.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service_role 키는 서버(Edge Function) 환경변수에만 둔다. 앱 번들에 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 교정 엔진
ANTHROPIC_API_KEY=

# 빌드·배포
EXPO_TOKEN=

# 관측 (Sentry) — 프로젝트 synk-pz/synk-talk · React Native
# ⚠ DSN 은 비밀이 아니다 — 클라이언트 번들에 그대로 실린다(누구나 앱에서 꺼낼 수 있다).
#    여기 이름만 두는 이유는 「어느 값이 필요한가」를 한 곳에 적기 위해서지 숨기려는 게 아니다.
EXPO_PUBLIC_SENTRY_DSN=

# 라디오24 수집봇 — YouTube OAuth 클라이언트 (GCP 프로젝트 synk-radio24 · unmet23 계정 · 게시 상태 「프로덕션」이라 리프레시 토큰이 7일 만료를 안 탄다)
# 리프레시 토큰은 아직 없다 — 어느 채널(계정)로 송출할지 확정(설계 §7-2 보류) 뒤에 그 계정으로 발급한다.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
